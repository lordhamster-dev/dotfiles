{
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    // Choose the order of the modules
    "modules-left": ["custom/logo", "sway/workspaces", "sway/window"],
    "modules-center": ["clock"],
    "modules-right": ["custom/recording", "custom/updates", "tray", "cpu", "memory", "pulseaudio", "backlight", "battery", "bluetooth", "network", "custom/power"],
    "custom/logo": {
        "exec": "if ~/dotfiles/scripts/idle-toggle.sh status | grep -q idle-on; then echo '{\"text\": \"󰣇\", \"class\": \"on\", \"tooltip\": \"空闲锁定已启用\\n点击禁用\"}'; else echo '{\"text\": \"󰣇\", \"class\": \"off\", \"tooltip\": \"空闲锁定已禁用\\n点击启用\"}'; fi",
        "return-type": "json",
        "interval": 5,
        "signal": 9,
        "on-click": "~/dotfiles/scripts/idle-toggle.sh toggle"
    },
    "sway/workspaces": {
        "disable-scroll": true,
        "sort-by-name": true,
        "on-click": "activate",
        "format": "{name} {windows}",
        "format-window-separator": " ",
        "window-rewrite-default": "󰣆",
        "window-format": "<span color='#e0e0e0'>{name}</span>",
        "window-rewrite": {
          "class<google-chrome>": "",
          "class<vivaldi-stable>": "",
          "class<chromium-browser>": "",
          "class<kitty>": "",
          "class<wechat>": "",
          "class<qq>": "",
          "class<obsidian>": "󱞁",
          "class<steam>": "",
          "class<org.gnome.Calculator>": ""
        }
    },
    "sway/window": {
        "format": "👉 {title}",
        "max-length": 50,
        "ellipsis": true
    },
    "clock": {
        "timezone": "Asia/Shanghai",
        "format": " {:%m-%d  %H:%M %a}",
        "format-alt": " {:%Y-%m-%d  %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "custom/recording": {
        "exec": "if [ -f /tmp/wf-recorder.pid ] && kill -0 $(cat /tmp/wf-recorder.pid) 2>/dev/null; then echo '{\"text\": \"● REC\", \"class\": \"recording\"}'; else echo '{\"text\": \"\", \"class\": \"\"}'; fi",
        "return-type": "json",
        "interval": 1,
        "tooltip": false
    },
    "custom/updates": {
        "exec": "count=$(sudo pacman -Qu | wc -l); if [ \"$count\" -gt 0 ]; then echo \"{\\\"text\\\": \\\"$count\\\", \\\"tooltip\\\": \\\"有 $count 个包需要更新\\\"}\"; fi",
        "return-type": "json",
        "interval": 1800,
        "format": "󰏕 {}",
        "on-click": "kitty --title yay -e yay -Syu --noconfirm",
        "signal": 8
    },
    "tray": {
        "spacing": 8
    },
    "cpu": {
        "interval": 5,
        "format": "󰍛 {usage}%",
        "tooltip": false,
        "on-click": "kitty --class btop-float -e btop"
    },
    "memory": {
        "interval": 5,
        "format": " {used}G",
        "tooltip-format": "Memory: {used}GiB used of {total}GiB ({percentage}%)",
        "on-click": "kitty --class htop-float -e htop"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "",
        "format-icons": {
            "default": ["", "", " "]
        },
        "on-click": "pavucontrol"
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "{icon} {percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "battery": {
        "interval": 5,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󱧦 {capacity}%",
        "format-alt": "{icon} {time}",
        "format-full": "󱟢",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "bluetooth": {
      "format": "",
      "format-disabled": "󰂲",
      "format-connected": "",
      "tooltip-format": "Devices connected: {num_connections}",
      "on-click": "blueberry"
    },
    "network": {
        "interval": 3,
        "format-wifi": " {essid}",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪",
        "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "sleep 0.15 && ~/dotfiles/scripts/fuzzel-wifimenu.sh"
    },
    "custom/power": {
        "tooltip": false,
        "format": "",
        "on-click": "sleep 0.15 && ~/dotfiles/scripts/fuzzel-powermenu.sh"
    }
}
